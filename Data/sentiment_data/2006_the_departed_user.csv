5.0,"[size=3][color=white][u][font=Andy]The Departed[/font][/u][font=Andy] 10 out of 10:fresh: [/font][/color][/size]

[size=3][color=white][u][font=Andy]Infernal Affairs[/font][/u][font=Andy] 8 out of 10:fresh: [/font][/color][/size]

